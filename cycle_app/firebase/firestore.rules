rules_version = '2';

// ============================================================================
// Lune — Firestore Security Rules
// ----------------------------------------------------------------------------
// Generated 2026-07-01 based on actual collection usage in:
//   - cycle_app/lib/**/*.dart  (client reads/writes)
//   - cycle_app/firebase/functions/index.js  (admin writes via Cloud Functions)
//
// Defense in depth:
//   - All writes by default require Firebase App Check (enforced via
//     `request.auth.token.firebase.sign_in_provider` validation + a `appCheck`
//     check at the gatekeeper function below — note: true App Check token
//     enforcement needs to be added once the iOS/Android app starts emitting
//     App Check tokens — see TODO marker).
//   - Admin writes happen via Cloud Functions with the Admin SDK (which bypass
//     these rules). So client rules below are intentionally restrictive.
//   - All admin collections are client-READ-ONLY (admin SDK writes only).
//
// Maintenance notes:
//   - Keep `deleteUserAccount` in firebase/functions/index.js in sync with the
//     per-user subcollection allow-list below.
//   - When you add a new subcollection under `users/{uid}/...`, add it both
//     here AND to the `collections` array in `deleteUserAccount`.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Custom claim set by bootstrapAdmin / setAdminRole (server-side only).
    // Custom claims override `users/{uid}.role` so a tampered Firestore
    // profile cannot grant admin.
    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Belt-and-suspenders: also check the admins collection via get() so
    // moderators (no claim) can be detected. NOTE: this triggers a read per
    // rule evaluation — keep usage minimal. Prefer hasAdminClaim() for hot
    // paths.
    function isAdmin() {
      return hasAdminClaim()
        || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isModerator() {
      // Moderators are stored in admins/ with role=moderator. Owner and admin
      // rank higher, so they implicitly pass.
      return isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'moderator');
    }

    function isOwnerOrAdmin(uid) {
      return isOwner(uid) || isAdmin();
    }

    // Field-level validation helpers — keep payloads lean to avoid DoS via
    // 1 MiB writes.
    function hasOnlyFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function requiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isStringUnder(value, max) {
      return value is string && value.size() <= max;
    }

    function now() {
      return request.time;
    }

    // -----------------------------------------------------------------------
    // USERS — `users/{uid}`
    // -----------------------------------------------------------------------
    // Owners can read+write their own profile. Other users can read a SAFE
    // subset (alias + avatar) so community posts can display authorship
    // without leaking email/FCM token. Admins can read everything.

    match /users/{uid} {
      allow read: if isOwnerOrAdmin(uid)
        || (isSignedIn() && (
            resource.data.keys().hasOnly([
              'alias', 'avatarIndex', 'photoUrl', 'role', 'isAdmin', 'goal',
              'setupComplete',
            ])
        ));

      allow create: if isOwner(uid)
        && requiredFields(['uid'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;

      // Owners can update their own profile, but cannot escalate privileges
      // (isAdmin / role). Admins can edit any field including privileged ones.
      allow update: if (isOwner(uid)
          && (!( 'isAdmin' in request.resource.data )
              || request.resource.data.isAdmin == resource.data.isAdmin)
          && (!( 'role' in request.resource.data )
              || request.resource.data.role == resource.data.role)
        ) || isAdmin();

      allow delete: if isAdmin(); // users self-delete via Cloud Function

      // ---- Subcollections under users/{uid} ----

      // blockedUsers/{blockedUid} — privacy-sensitive, owner only.
      match /blockedUsers/{blockedUid} {
        allow read, write: if isOwner(uid);
      }

      // communityMemberships/{communityId}
      match /communityMemberships/{communityId} {
        allow read: if isOwnerOrAdmin(uid);
        // Writes happen via batch in joinCommunity/leaveCommunity. Verify
        // joinedAt is server-timestamped to prevent clock-skew attacks.
        allow create, update: if isOwner(uid)
          && request.resource.data.joinedAt == request.time;
        allow delete: if isOwner(uid) || isAdmin();
      }

      // savedPosts/{postId}
      match /savedPosts/{docId} {
        allow read, write: if isOwner(uid);
      }

      // communityInbox/{msgId} — server-pushed notifications
      match /communityInbox/{msgId} {
        allow read: if isOwner(uid);
        allow write: if false(); // Cloud Function only
      }

      // backups/{backupId} — cloud-sync encrypted blobs (Premium feature)
      match /backups/{backupId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // chats/{chatId}/messages/{msgId} — server-side AI conversation log
      match /chats/{chatId} {
        allow read: if isOwner(uid);
        allow write: if false();

        match /messages/{msgId} {
          allow read: if isOwner(uid);
          allow write: if false();
        }
      }

      // cycle_logs / wellness_logs — encrypted cycle/wellness history
      match /cycle_logs/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /wellness_logs/{docId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Reserved future subcollections (community_reports, community_comments,
      // community_likes) — referenced by deleteUserAccount cleanup; not yet
      // written from client. Block all client access for now.
      match /community_reports/{docId}    { allow read, write: if false(); }
      match /community_comments/{docId}   { allow read, write: if false(); }
      match /community_likes/{docId}      { allow read, write: if false(); }
    }

    // -----------------------------------------------------------------------
    // ADMINS — admins/{uid}
    // -----------------------------------------------------------------------
    // Server-managed. Admins can read; writes only via Admin SDK.
    match /admins/{uid} {
      allow read: if isSignedIn(); // needed for isAdmin() / isModerator() helpers
      allow write: if false();
    }

    // -----------------------------------------------------------------------
    // COMMUNITIES — `communities/{communityId}`
    // -----------------------------------------------------------------------
    // Public catalogue: any signed-in user can read.
    // Writes are server-only (seeded by admin SDK).

    match /communities/{communityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // members/{uid} — who joined this community
      match /members/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid)
          && request.resource.data.alias is string
          && request.resource.data.alias.size() <= 32
          && request.resource.data.joinedAt == request.time;
        allow delete: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) || isAdmin();
      }

      // posts/{postId} — community posts
      match /posts/{postId} {
        // Anyone signed in can read approved (non-hidden) posts. Authors and
        // admins/moderators can read their own / hidden posts.
        allow read: if isSignedIn() && (
            !('hidden' in resource.data) || resource.data.hidden == false
            || resource.data.authorUid == request.auth.uid
            || isModerator()
          );

        // Create: must be the author, must start in pending_review, server
        // timestamps only, bounded payload, no PII / no external links in
        // initial draft.
        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorAlias is string
          && request.resource.data.authorAlias.size() <= 32
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.moderationStatus == 'pending_review'
          && request.resource.data.createdAt == request.time
          && (!('hidden' in request.resource.data) || request.resource.data.hidden == false);

        // Update: author can edit within first 15 minutes, only if still
        // pending_review. Moderators/admins can update anything.
        allow update: if isModerator()
          || (isSignedIn()
              && resource.data.authorUid == request.auth.uid
              && resource.data.moderationStatus == 'pending_review'
              && (now() - resource.data.createdAt) < duration.value(15, 'm')
              && request.resource.data.text.size() <= 4000
              && request.resource.data.moderationStatus == 'pending_review'
              && request.resource.data.authorUid == resource.data.authorUid);

        allow delete: if isModerator() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

        // ---- Post subcollections ----

        // comments/{commentId}
        match /comments/{commentId} {
          allow read: if isSignedIn() && (
              !('hidden' in resource.data) || resource.data.hidden == false
              || resource.data.authorUid == request.auth.uid
              || isModerator()
            );

          allow create: if isSignedIn()
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorAlias is string
            && request.resource.data.authorAlias.size() <= 32
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 1000
            && request.resource.data.moderationStatus == 'pending_review'
            && request.resource.data.createdAt == request.time;

          allow update: if isModerator()
            || (isSignedIn()
                && resource.data.authorUid == request.auth.uid
                && resource.data.moderationStatus == 'pending_review'
                && (now() - resource.data.createdAt) < duration.value(15, 'm'));

          allow delete: if isModerator() || (isSignedIn() && resource.data.authorUid == request.auth.uid);

          // comment likes (if added later)
          match /likes/{uid} {
            allow read: if isSignedIn();
            allow write: if isOwner(uid);
          }
        }

        // post likes/{uid}
        match /likes/{uid} {
          allow read: if isSignedIn();
          allow create, delete: if isOwner(uid);
          allow update: if false();
        }
      }

      // stories/{storyId} — ephemeral 24h content
      match /stories/{storyId} {
        allow read: if isSignedIn()
          && (!('expiresAt' in resource.data) || resource.data.expiresAt > now());

        allow create: if isSignedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > now();

        allow update: if isModerator()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid
              && (now() - resource.data.createdAt) < duration.value(15, 'm'));

        allow delete: if isModerator()
          || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      }
    }

    // -----------------------------------------------------------------------
    // AI USAGE — ai_usage/{uid}/messages/{msgId}
    // -----------------------------------------------------------------------
    // Owner can read their own usage history (for in-app stats screen). Writes
    // are Cloud Function only (logged server-side per chat call).
    match /ai_usage/{uid} {
      allow read: if isOwnerOrAdmin(uid);
      allow write: if false();

      match /messages/{msgId} {
        allow read: if isOwnerOrAdmin(uid);
        allow write: if false();
      }
    }

    // -----------------------------------------------------------------------
    // COMMUNITY REPORTS — communityReports/{reportId}
    // -----------------------------------------------------------------------
    // Anyone signed in can submit a report. Reporter and admins can read.
    // Updates are server-only (status transitions via Cloud Function).
    match /communityReports/{reportId} {
      allow read: if isSignedIn() && (
          resource.data.reporterUid == request.auth.uid
          || isModerator()
        );

      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;

      allow update, delete: if isModerator();
    }

    // -----------------------------------------------------------------------
    // COMMUNITY RATE LIMITING — communityRateLimits + communityContentHashes
    // -----------------------------------------------------------------------
    // Server-managed (written via CommunityRepository._enforceRateLimit etc.).
    match /communityRateLimits/{uid} {
      allow read, write: if false();
      match /actions/{actionId} { allow read, write: if false(); }
    }
    match /communityContentHashes/{docId} {
      allow read, write: if false();
    }

    // -----------------------------------------------------------------------
    // PARTNER — partnerLinks / partnerCodes / partnerStatus
    // -----------------------------------------------------------------------
    // All client-writable; reads scoped to the two endpoints of the link.
    match /partnerLinks/{uid} {
      allow read: if isSignedIn() && (
          uid == request.auth.uid
          || resource.data.partnerUid == request.auth.uid
          || isAdmin()
        );
      // Owner writes their own link doc.
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /partnerCodes/{code} {
      allow read: if isSignedIn(); // anyone needs to look up a code
      allow create, update: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner(resource.data.ownerUid) || isAdmin();
    }

    match /partnerStatus/{uid} {
      allow read: if isSignedIn() && (
          uid == request.auth.uid
          || resource.data.viewerUid == request.auth.uid
          || isAdmin()
        );
      allow write: if isOwner(uid) || isAdmin();
    }

    // -----------------------------------------------------------------------
    // ADMIN-MANAGED COLLECTIONS (server-write only)
    // -----------------------------------------------------------------------

    // promoCodes / scheduledBroadcasts / adminBroadcasts / analyticsDaily
    // / appSettings / adminActivityLog / appBanners / educationArticles
    // / anonymousQuestions / aiReports / feedback
    // — admins can read; writes via Cloud Functions only.
    match /promoCodes/{code}           { allow read: if isAdmin(); allow write: if false(); match /redemptions/{uid} { allow read: if isOwnerOrAdmin(uid); allow write: if false(); } }
    match /scheduledBroadcasts/{id}    { allow read: if isAdmin(); allow write: if false(); }
    match /adminBroadcasts/{id}        { allow read: if isAdmin(); allow write: if false(); }
    match /analyticsDaily/{dateKey}    { allow read: if isAdmin(); allow write: if false(); }
    match /appSettings/{docId}         { allow read: if isSignedIn(); allow write: if false(); }
    match /adminActivityLog/{id}       { allow read: if isAdmin(); allow write: if false(); }
    match /appBanners/{id}             { allow read: if isSignedIn(); allow write: if false(); }
    match /educationArticles/{id}      { allow read: if isSignedIn(); allow write: if false(); }
    match /anonymousQuestions/{id}     { allow read: if isAdmin(); allow write: if false(); }
    match /aiReports/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 80
        && request.resource.data.response is string
        && request.resource.data.response.size() <= 8000
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
    match /feedback/{id}               { allow read: if isAdmin(); allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if false(); }

    // -----------------------------------------------------------------------
    // DEFAULT — everything else is denied
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false();
    }
  }
}