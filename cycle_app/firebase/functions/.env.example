# Copy to .env for local emulator / deploy-time secrets (never commit .env).
# Cloud Functions v2 reads these via process.env when deployed with firebase deploy.

# false = log missing App Check tokens but allow requests (staged rollout).
# true  = reject requests without a valid X-Firebase-AppCheck header.
APP_CHECK_ENFORCE=false

# Debug-only premium grant endpoint — must stay false in production.
TESTER_PREMIUM_ENABLED=false

# Comma-separated CORS origins for HTTP Cloud Functions.
ALLOWED_ORIGINS=https://lune-7d956.web.app,https://lune-7d956.firebaseapp.com

# Pub/Sub push audience for googlePlayWebhook OIDC verification.
# Must match the push endpoint URL configured on the RTDN subscription.
PLAY_WEBHOOK_AUDIENCE=https://us-central1-lune-7d956.cloudfunctions.net/googlePlayWebhook
