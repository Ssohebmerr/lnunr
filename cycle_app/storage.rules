rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function isSignedIn() {

      return request.auth != null;

    }



    function isOwner(uid) {

      return isSignedIn() && request.auth.uid == uid;

    }



    // Community post media uploads are enabled for premium users.
    match /community_media/{communityId}/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid)
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'video/mp4');
    }



    // Profile photos: owner only, JPEG, max 5 MB.

    match /profile_photos/{uid}/{fileName} {

      allow read: if isSignedIn();

      allow write: if isOwner(uid)

        && request.resource.size < 5 * 1024 * 1024

        && request.resource.contentType == 'image/jpeg';

      allow delete: if isOwner(uid);

    }

  }

}


