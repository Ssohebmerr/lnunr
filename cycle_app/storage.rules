rules_version = '2';

service firebase.storage {

  match /b/{bucket}/o {

    function isSignedIn() {

      return request.auth != null;

    }



    function isOwner(uid) {

      return isSignedIn() && request.auth.uid == uid;

    }



    function approximateAge(birthYear) {

      let yearNow = 1970 + int(request.time.toMillis() / 31557600000);

      return yearNow - birthYear;

    }



    function isCommunityAdult() {

      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));

      let birthYear = int(userDoc.data.get('communityBirthYear', 0));

      return birthYear > 0 && approximateAge(birthYear) >= 18;

    }

    function isCommunityPremium() {

      let userDoc = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));

      return userDoc.data.get('isPremium', false) == true;

    }

    function isCommunityMember(communityId) {
      return firestore.exists(
        /databases/(default)/documents/communities/$(communityId)/members/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return isSignedIn() && firestore.exists(
        /databases/(default)/documents/admins/$(request.auth.uid)
      );
    }

    function isCommunityMediaApproved(communityId, uid, fileName) {
      return firestore.exists(
        /databases/(default)/documents/communityMediaApprovals/$(communityId)/owners/$(uid)/files/$(fileName)
      );
    }



    // Community post media uploads are enabled for premium users.
    match /community_media/{communityId}/{uid}/{fileName} {
      // The uploader may preview a pending upload. Everyone else can read it
      // only after the trusted Function writes a moderation approval record.
      allow read: if isOwner(uid) || (
        isCommunityAdult()
        && isCommunityMember(communityId)
        && isCommunityMediaApproved(communityId, uid, fileName)
      );
      allow create, update: if isOwner(uid)
        && isCommunityAdult()
        && isCommunityPremium()
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == 'image/jpeg' || request.resource.contentType == 'video/mp4');
      // request.resource does not exist for deletes, so keep the delete rule
      // separate from uploads instead of accidentally blocking cleanup.
      allow delete: if isOwner(uid) && isCommunityAdult();
    }



    // Profile photos: owner only, JPEG, max 5 MB.

    match /profile_photos/{uid}/{fileName} {

      allow read: if isOwner(uid);

      allow write: if isOwner(uid)

        && request.resource.size < 5 * 1024 * 1024

        && request.resource.contentType == 'image/jpeg';

      allow delete: if isOwner(uid);

    }

    // Public editorial covers. Only trusted admins can upload/replace them;
    // public read keeps magazine images cacheable on app and website clients.
    match /magazine_covers/{articleId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }

  }

}
